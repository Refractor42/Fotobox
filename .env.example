# SnapBox / Fotobox — environment template
# Copy this file to `.env` and fill in your own values:
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed or shared in chat/issues.
# The service role key bypasses Supabase row-level security, so it belongs
# only on the machine running the dev server.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Server-only key from Supabase → Project Settings → API → service_role.
# Never use this in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket that holds photos under photos/ and trash/.
SUPABASE_BUCKET=

# Optional: dev server port (defaults to 8443).
# PORT=8443

# Optional: serve plain HTTP for local automated testing only.
# HTTP_ONLY=1
